# Notebook: copie este arquivo para .env na raiz do projeto.
# Variáveis já definidas pelo servidor têm prioridade.
APP_ENV=development
SECRET_KEY=troque-por-uma-chave-longa-e-aleatoria
LSD_ACCESS_CODE=00001
ADMIN_EMAIL=bryan.william10@aluno.ifce.edu.br
BACKUP_RETENTION=5
BACKUP_TIMEZONE=America/Fortaleza
PUBLIC_BASE_URL=http://127.0.0.1:5000

# console: mostra a mensagem no terminal, sem enviar e-mail (só desenvolvimento).
# smtp: entrega real usando a conta de envio configurada abaixo.
MAIL_BACKEND=console
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_SECURITY=starttls
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=desenvolvimento@example.com

# No servidor institucional: use APP_ENV=production, MAIL_BACKEND=smtp,
# PUBLIC_BASE_URL=http://lsd.maranguape.ifce.edu.br e credenciais autorizadas.
