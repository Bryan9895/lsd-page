# Copie este arquivo para .env na raiz do projeto.
# Variáveis definidas diretamente no servidor têm prioridade sobre o .env.
APP_ENV=development
SECRET_KEY=troque-por-uma-chave-longa-e-aleatoria
LSD_ACCESS_CODE=00001
ADMIN_EMAIL=bryan.william10@aluno.ifce.edu.br
BACKUP_RETENTION=5
BACKUP_TIMEZONE=America/Fortaleza

# Origem pública usada nos links de redefinição de senha.
# Local com Flask servindo o frontend: http://127.0.0.1:5000
# PythonAnywhere: https://SEU_USUARIO.pythonanywhere.com
# Servidor institucional: http://lsd.maranguape.ifce.edu.br
PUBLIC_BASE_URL=http://127.0.0.1:5000

# ============================================================
# E-MAIL
# ============================================================
# console: apenas imprime a mensagem no terminal; somente desenvolvimento.
# smtp: entrega real. Gmail com senha de app já conta como provedor SMTP.
MAIL_BACKEND=console
MAIL_PROVIDER=gmail
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_SECURITY=starttls
MAIL_TIMEOUT=10
MAIL_BATCH_SIZE=40

# Conta que autentica no servidor SMTP.
MAIL_USERNAME=
# Senha de app/SMTP. Não use a senha normal da conta e nunca faça commit do .env.
# Para senha de app do Google, use os 16 caracteres sem espaços.
MAIL_PASSWORD=

# Remetente visível. Normalmente é o mesmo endereço de MAIL_USERNAME.
MAIL_FROM=
# Opcional: endereço para respostas dos comunicados.
MAIL_REPLY_TO=

# Quando MAIL_BACKEND=smtp e as variáveis acima estiverem completas:
# - /api/recuperar-senha envia automaticamente o link de redefinição;
# - comunicados do admin tentam enviar por e-mail além da notificação interna;
# - GET  /api/admin/email/status mostra diagnóstico seguro da configuração;
# - POST /api/admin/email/teste envia um teste apenas para o e-mail do admin logado.

# Produção/deploy:
# DATABASE_PATH=/caminho/persistente/lsd_database.db
# UPLOAD_FOLDER=/caminho/persistente/uploads
# BACKUP_FOLDER=/caminho/persistente/backups
