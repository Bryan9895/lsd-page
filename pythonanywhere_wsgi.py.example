"""Exemplo WSGI: ajuste PROJECT_HOME e configure os segredos no .env ignorado pelo Git."""

import os
import sys

PROJECT_HOME = "/home/SEU_USUARIO/site_lsd/lsd-page"

if PROJECT_HOME not in sys.path:
    sys.path.insert(0, PROJECT_HOME)

os.environ["APP_ENV"] = "production"
# O arquivo real deve estar neste local antes do primeiro Reload.
os.environ["DATABASE_PATH"] = os.path.join(PROJECT_HOME, "backend", "instance", "lsd_database.db")
os.environ.setdefault("UPLOAD_FOLDER", os.path.join(PROJECT_HOME, "backend", "uploads"))
os.environ.setdefault("BACKUP_FOLDER", os.path.join(PROJECT_HOME, "backend", "backups"))

from backend.app import app as application
